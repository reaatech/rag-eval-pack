{
  "name": "@reaatech/rag-eval-mcp-server",
  "version": "0.1.0",
  "description": "MCP server exposing RAG evaluation tools (judge, suite, gate)",
  "license": "MIT",
  "author": "Rick Somers <rick@reaatech.com> (https://reaatech.com)",
  "repository": {
    "type": "git",
    "url": "https://github.com/reaatech/rag-eval-pack.git",
    "directory": "packages/mcp-server"
  },
  "homepage": "https://github.com/reaatech/rag-eval-pack/tree/main/packages/mcp-server#readme",
  "bugs": {
    "url": "https://github.com/reaatech/rag-eval-pack/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "rag-eval-mcp-server": "./dist/bin.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts src/bin.ts --format cjs,esm --dts --clean",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.9.0",
    "@reaatech/rag-eval-core": "workspace:*",
    "@reaatech/rag-eval-gate": "workspace:*",
    "@reaatech/rag-eval-metrics": "workspace:*",
    "@reaatech/rag-eval-suite": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "tsup": "^8.4.0",
    "typescript": "^6.0.3",
    "vitest": "^3.2.6"
  }
}
