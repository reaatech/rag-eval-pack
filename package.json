{
  "name": "rag-eval-pack",
  "version": "0.1.0",
  "private": true,
  "description": "Evaluation toolkit for RAG (Retrieval-Augmented Generation) systems \u2014 monorepo of composable metrics, judges, gates, and CLI tools",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "bootstrap": "pnpm install && turbo run build",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "clean": "turbo run clean && rm -rf node_modules",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build && changeset publish"
  },
  "keywords": [
    "rag",
    "evaluation",
    "llm",
    "metrics",
    "faithfulness",
    "relevance",
    "context-precision",
    "context-recall",
    "ci-cd",
    "mcp"
  ],
  "author": "Rick Somers <rick@reaatech.com> (https://reaatech.com)",
  "license": "MIT",
  "packageManager": "pnpm@10.22.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/reaatech/rag-eval-pack.git"
  },
  "bugs": {
    "url": "https://github.com/reaatech/rag-eval-pack/issues"
  },
  "homepage": "https://github.com/reaatech/rag-eval-pack#readme",
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.28.1",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "3.2.4",
    "turbo": "^2.9.14",
    "typescript": "^6.0.3",
    "vitest": "^3.1.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "uuid": ">=14.0.0",
      "brace-expansion": ">=5.0.6",
      "fast-uri": ">=3.1.2",
      "hono": ">=4.12.18",
      "ip-address": ">=10.1.1",
      "glob>minimatch": ">=10.0.0",
      "qs": ">=6.15.2"
    }
  }
}
